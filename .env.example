# AI chat (server-side only, used by /api/chat — never prefix these with VITE_)
# Primary: Vercel AI Gateway. On Vercel, OIDC auth works without a key; set a key for local dev.
AI_GATEWAY_API_KEY=
# Optional ordered list of gateway models (comma-separated)
# AI_GATEWAY_MODELS=deepseek/deepseek-v4-flash,openai/gpt-4o-mini
# Fallback: OpenRouter free models (skipped when the key is not set)
OPENROUTER_API_KEY=
# OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,openrouter/free

# n8n Webhook URLs
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/stigg-quote-request
VITE_N8N_LEAD_ROUTING_URL=http://localhost:5678/webhook/stigg-lead-routing

# Note: only VITE_* variables are exposed to the browser. Keep AI keys server-side.